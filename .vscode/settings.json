{
  "cmake.sourceDirectory": "${workspaceFolder}/native",
  "cmake.buildDirectory": "${workspaceFolder}/native/build",
  "cmake.configureSettings": {
    "BROOD_BUILD_PLUGIN": "ON",
    "CMAKE_BUILD_TYPE": "Release"
  },
  "cmake.configureOnOpen": false,
  "files.associations": { "*.h": "cpp", "*.cjs": "javascript" },
  "files.exclude": {
    "native/build": true
  },
  "search.exclude": {
    "native/build": true,
    "node_modules": true,
    "dist": true
  }
}
